# Airflow — template for .env. Copy to .env and fill in real values:
#   cp .env.example .env
# Airflow reads AIRFLOW__<SECTION>__<KEY> env vars and they override airflow.cfg.

# --- [core] -------------------------------------------------------------
# Encrypts connection/variable passwords in the metadata DB.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=

# --- [database] ---------------------------------------------------------
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=sqlite:////opt/airflow/airflow.db

# --- [api] / [api_auth] -------------------------------------------------
# Generate either: python -c "import base64,os; print(base64.b64encode(os.urandom(16)).decode())"
AIRFLOW__API__SECRET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=

# --- SMTP -----------------------------------------------------------------
# The smtp provider reads the Airflow connection "smtp_default", NOT the [smtp]
# section of airflow.cfg. Define it here. Gmail needs an App Password.
# Use port 465 with implicit SSL if 587/STARTTLS is blocked on your network.
AIRFLOW_CONN_SMTP_DEFAULT={"conn_type":"smtp","host":"smtp.gmail.com","port":465,"login":"","password":"","extra":{"from_email":"","disable_tls":true,"timeout":30}}

# --- [celery] -----------------------------------------------------------
# Only used when the CeleryExecutor is enabled.
AIRFLOW__CELERY__BROKER_URL=redis://redis:6379/0

# --- DAG-level settings -------------------------------------------------
# Recipient of the retail_alert_pipeline email.
ALERT_EMAIL_TO=
